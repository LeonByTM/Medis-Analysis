      <data key="d6">1</data>
      <data key="d7">["154330"]</data>
      <data key="d8">["Case in point: Today, ElevenLabs, the well-funded voice and AI sound effects startup founded by former Palantir engineers, debuted Conversational AI 2.0, a significant upgrade to its platform for building advanced voice agents for enterprise use cases, such as customer support, call centers, and outbound sales and marketing."]</data>
      <data key="d9">same_sentence_entity_cooccurrence</data>
    </edge>
    <edge source="organization:elevenlabs" target="organization:mistral-ai">
      <data key="d4">MENTIONED_WITH</data>
      <data key="d5">cooccurrence</data>
      <data key="d6">2</data>
      <data key="d7">["154452", "62173"]</data>
      <data key="d8">["Subscribe Now Mistral released an open-sourced voice model today that could rival paid voice AI, such as those from ElevenLabs and Hume AI, which the company said bridges the gap between proprietary speech recognition models and the more open, yet error-prone versions.", "Qolaba AI\nQolaba AI Studio is an all-in-one generative AI toolkit that unifies premium models from OpenAI, Anthropic, Stability AI, Google, Mistral, and ElevenLabs, enabling seamless multi-modal content creation for text, images, audio, and soon video without coding."]</data>
      <data key="d9">same_sentence_entity_cooccurrence</data>
    </edge>
