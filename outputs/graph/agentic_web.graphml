      <data key="d8">["In the past few months, at least two agentic interoperability standards have emerged: Anthropic’ s Model Context Protocol ( MCP) and AGNTCY, from a collective led by Cisco."]</data>
      <data key="d9">same_sentence_entity_cooccurrence</data>
    </edge>
    <edge source="organization:agntcy" target="protocol:model-context-protocol">
      <data key="d4">MENTIONED_WITH</data>
